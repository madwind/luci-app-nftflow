{
    "luci-app-nftflow": {
        "description": "Manage NftFlow runtime, configuration, firewall, routing and updates",
        "read": {
            "uci": [ "nftflow" ],
            "ubus": {
                "log": [ "read", ":subscribe" ],
                "luci.nftflow": [
                    "status",
                    "firewall_read",
                    "firewall_validate",
                    "routing_read",
                    "routing_validate",
                    "config_read",
                    "config_validate",
                    "geo_status",
                    "update_status",
                    "update_settings"
                ],
                "luci.nftflow.defaults": [ "firewall", "config", "routing" ]
            }
        },
        "write": {
            "uci": [ "nftflow" ],
            "ubus": {
                "luci.nftflow": [
                    "config_apply",
                    "config_save",
                    "firewall_save",
                    "firewall_apply",
                    "routing_save",
                    "routing_apply",
                    "geo_stop",
                    "update_check",
                    "update_install",
                    "update_stop",
                    "update_set_check",
                    "update_set_auto",
                    "action",
                    "service_sync"
                ]
            }
        }
    }
}
