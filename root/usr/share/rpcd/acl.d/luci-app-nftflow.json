{
    "luci-app-nftflow": {
        "description": "Manage NftFlow runtime, configuration, firewall, routing and updates",
        "read": {
            "uci": [ "nftflow" ],
            "ubus": {
                "log": [ "read", ":subscribe" ],
                "luci.nftflow": [
                    "status",
                    "service_runtime",
                    "firewall_read",
                    "firewall_runtime",
                    "firewall_action_status",
                    "routing_read",
                    "routing_runtime",
                    "config_read",
                    "update_status",
                    "update_settings"
                ],
                "luci.nftflow.metrics": [ "traffic" ],
                "luci.nftflow.defaults": [ "firewall", "routing" ]
            }
        },
        "write": {
            "uci": [ "nftflow" ],
            "ubus": {
                "luci.nftflow": [
                    "service_sync",
                    "config_apply",
                    "firewall_save",
                    "firewall_install",
                    "firewall_uninstall",
                    "routing_save",
                    "routing_install",
                    "routing_uninstall",
                    "update_check",
                    "update_install",
                    "update_set_check",
                    "update_set_auto",
                    "action"
                ]
            }
        }
    }
}
