table inet nftflow {
    set nftflow_bypass4 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { %geoip:private%, %geoip:cn% }
    }
    set nftflow_bypass6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = { %geoip:private%, %geoip:cn% }
    }
    chain nftflow_prerouting {
        type filter hook prerouting priority mangle - 1;
        policy accept;
        ct direction reply counter return
        meta mark & 0xfe != 0x0 counter return
        meta l4proto { tcp, udp } th dport 53 meta mark set 0x1 tproxy to :%port% counter accept
        fib daddr type local return
        meta nfproto ipv4 ip daddr @nftflow_bypass4 return
        meta nfproto ipv6 ip6 daddr @nftflow_bypass6 return
        meta l4proto { tcp, udp } meta mark set 0x1 tproxy to :%port% counter accept
    }
    chain nftflow_output {
        type route hook output priority mangle - 1;
        policy accept;
        meta skgid %gid% counter return
        ct direction reply counter return
        meta mark & 0xff != 0x0 counter return
        meta l4proto { tcp, udp } th dport 53 meta mark set 0x1 counter accept
        fib daddr type local return
        meta nfproto ipv4 ip daddr @nftflow_bypass4 return
        meta nfproto ipv6 ip6 daddr @nftflow_bypass6 return
        meta l4proto { tcp, udp } meta mark set 0x1 counter accept
    }
}
