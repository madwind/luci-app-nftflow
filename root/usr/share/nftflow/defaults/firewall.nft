table inet nftflow {
    set nftflow_bypass4 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { %geoip:private%, %geoip:cn% }
    }

    chain nftflow_prerouting {
        type filter hook prerouting priority mangle - 1;
        policy accept;

        ct direction reply counter return
        meta mark & 0x00010000 != 0 counter return
        meta nfproto != ipv4 return

        udp dport { 67, 68 } return
        ip daddr 255.255.255.255 return
        ip daddr 224.0.0.0/4 return

        meta l4proto { tcp, udp } th dport 53 counter return
        fib daddr type local return
        ip daddr @nftflow_bypass4 return

        meta l4proto { tcp, udp } meta mark set meta mark | 0x00000001 tproxy to :12345 counter accept
    }

    chain nftflow_output {
        type route hook output priority mangle - 1;
        policy accept;

        meta skgid 23333 counter return
        ct direction reply counter return
        meta nfproto != ipv4 return

        meta l4proto { tcp, udp } th dport 53 counter return
        fib daddr type local return
        ip daddr @nftflow_bypass4 return

        meta l4proto { tcp, udp } meta mark set meta mark | 0x00000001 counter accept
    }
}
