#!/bin/sh

. /usr/share/libubox/jshn.sh

AUTO=/usr/libexec/nftflow/geo-auto.sh
SMART=/usr/libexec/nftflow/geo-smart-update.lua

read_request() {
    local raw
    raw="$(cat)"
    [ -n "$raw" ] || raw='{}'
    json_load "$raw" 2>/dev/null || json_init
}

case "$1" in
list)
    printf '%s\n' '{"status":{},"set_auto":{"kind":"","enabled":0},"update":{"kind":""}}'
    ;;
call)
    case "$2" in
        status) exec "$AUTO" status;;
        set_auto)
            read_request
            json_get_var kind kind
            json_get_var enabled enabled
            exec "$AUTO" set "$kind" "$enabled"
            ;;
        update)
            read_request
            json_get_var kind kind
            exec /usr/bin/lua "$SMART" update "$kind"
            ;;
        *) printf '%s\n' '{"ok":false,"error":"unknown method"}'; exit 1;;
    esac
    ;;
*) exit 1;;
esac
