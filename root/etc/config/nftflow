config nftflow 'main'
    option enabled '0'
    option xray_bin '/usr/bin/xray'
    option config_file '/etc/nftflow/config.yaml'
    option asset_dir '/usr/share/xray'
    option geoip_file '/usr/share/xray/geoip.dat'
    option geosite_file '/usr/share/xray/geosite.dat'
    option geoip_url 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat'
    option geosite_url 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat'
    option update_check_enabled '0'
    option nftflow_auto_update '0'
    option xray_auto_update '0'
    option geoip_auto_update '0'
    option geosite_auto_update '0'

    # The YAML editor owns Xray's complete core configuration. Runtime-only
    # placeholders keep the interception port and process GID synchronized:
    # %port% resolves to listen_port and %gid% resolves to run_gid.
    option listen_port '12345'
    option run_gid '23333'
    option run_group 'nftflow'
    option nofile '65536'
