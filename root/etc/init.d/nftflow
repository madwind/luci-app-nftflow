#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=15
EXTRA_COMMANDS="install geodata_schedule uninstall"
EXTRA_HELP="
    install             Prepare runtime files
    geodata_schedule    Synchronize the weekly GeoData update schedule
    uninstall           Stop NftFlow and remove runtime integration"

NAME=nftflow
CTL=/usr/libexec/nftflow/nftflowctl
GEO_AUTO=/usr/libexec/nftflow/geo-auto.sh
RUNTIME_CONFIG=/var/run/nftflow/config.applied.json
GROUP_STATE=/etc/nftflow/groups.created

load_main() {
    config_load nftflow
    config_get enabled main enabled 0
    config_get xray_bin main xray_bin /usr/bin/xray
    config_get config_file main config_file /etc/nftflow/config.json
    config_get asset_dir main asset_dir /usr/share/xray
    config_get run_gid main run_gid 23333
    config_get run_group main run_group nftflow
    config_get nofile main nofile 65536
}

install_geodata_schedule() {
    "$GEO_AUTO" sync >/dev/null 2>&1
}

geodata_schedule() {
    install_geodata_schedule
}

remove_geodata_schedule() {
    "$GEO_AUTO" remove >/dev/null 2>&1
}

record_created_group() {
    mkdir -p "${GROUP_STATE%/*}" 2>/dev/null || return 1
    touch "$GROUP_STATE" 2>/dev/null || return 1
    chmod 0600 "$GROUP_STATE" 2>/dev/null || true
    grep -qxF "$run_group:$run_gid" "$GROUP_STATE" 2>/dev/null ||
        printf '%s:%s\n' "$run_group" "$run_gid" >> "$GROUP_STATE"
}

remove_created_groups() {
    [ -f "$GROUP_STATE" ] || return 0

    while IFS=: read -r group gid; do
        case "$gid" in
            ''|*[!0-9]*) continue ;;
        esac
        case "$group" in
            ''|*[!A-Za-z0-9_-]*) continue ;;
        esac

        grep -q "^${group}:[^:]*:${gid}:" /etc/group 2>/dev/null || continue
        awk -F: -v gid="$gid" '$4 == gid { found = 1 } END { exit found ? 0 : 1 }' /etc/passwd 2>/dev/null && {
            logger -t nftflow "keeping group $group because GID $gid is used by a passwd entry"
            continue
        }

        if command -v delgroup >/dev/null 2>&1; then
            delgroup "$group" >/dev/null 2>&1 || true
        fi
        if grep -q "^${group}:[^:]*:${gid}:" /etc/group 2>/dev/null; then
            tmp="/etc/group.nftflow.$$"
            awk -F: -v group="$group" -v gid="$gid" '!( $1 == group && $3 == gid )' /etc/group > "$tmp" 2>/dev/null &&
                cat "$tmp" > /etc/group
            rm -f "$tmp"
        fi
    done < "$GROUP_STATE"

    rm -f "$GROUP_STATE"
}

ensure_group() {
    # Keep the real user as root for Xray's transparent-proxy operation and
    # assign the configured primary group through procd; never create a second
    # uid=0 passwd identity.
    case "$run_gid" in
        ''|*[!0-9]*) logger -t nftflow "invalid run_gid: $run_gid"; return 1 ;;
        0) logger -t nftflow "run_gid must be non-zero"; return 1 ;;
    esac
    case "$run_group" in
        ''|*[!A-Za-z0-9_-]*) logger -t nftflow "invalid run_group: $run_group"; return 1 ;;
    esac

    if ! grep -q "^${run_group}:[^:]*:${run_gid}:" /etc/group 2>/dev/null; then
        grep -q "^${run_group}:" /etc/group 2>/dev/null && {
            logger -t nftflow "group $run_group already exists with a different GID"
            return 1
        }
        group_for_gid="$(awk -F: -v gid="$run_gid" '$3 == gid { print $1; exit }' /etc/group 2>/dev/null)"
        if [ -n "$group_for_gid" ]; then
            case "$group_for_gid" in
                *[!A-Za-z0-9_-]*)
                    logger -t nftflow "invalid existing group name for GID $run_gid"
                    return 1
                    ;;
            esac
            [ "$group_for_gid" = "$run_group" ] || {
                logger -t nftflow "using existing group $group_for_gid for GID $run_gid"
                run_group="$group_for_gid"
            }
        else
            if command -v addgroup >/dev/null 2>&1; then
                addgroup -S -g "$run_gid" "$run_group" 2>/dev/null || \
                    addgroup -g "$run_gid" "$run_group" 2>/dev/null || true
            fi
            if ! grep -q "^${run_group}:[^:]*:${run_gid}:" /etc/group 2>/dev/null; then
                grep -q "^[^:]*:[^:]*:${run_gid}:" /etc/group 2>/dev/null && {
                    logger -t nftflow "GID $run_gid is already used by another group"
                    return 1
                }
                printf '%s:x:%s:\n' "$run_group" "$run_gid" >> /etc/group 2>/dev/null || {
                    logger -t nftflow "cannot write /etc/group for $run_group"
                    return 1
                }
            fi
            record_created_group || logger -t nftflow "cannot record created group $run_group"
        fi
    fi

    grep -q "^${run_group}:[^:]*:${run_gid}:" /etc/group 2>/dev/null || {
        logger -t nftflow "cannot create group $run_group with gid $run_gid"
        return 1
    }
}

service_process_running() {
    local pid expected actual
    pid="$(cat /var/run/nftflow/xray.pid 2>/dev/null)"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$pid" -gt 1 ] || return 1
    kill -0 "$pid" >/dev/null 2>&1 || return 1
    expected="$(readlink -f "$xray_bin" 2>/dev/null)"
    actual="$(readlink -f "/proc/$pid/exe" 2>/dev/null)"
    [ -n "$expected" ] && [ "$actual" = "$expected" ] || return 1
    return 0
}

start_service() {
    load_main
    "$CTL" prepare || return 1
    [ "$enabled" = "1" ] || [ "${NFTFLOW_FORCE_START:-0}" = "1" ] || {
        "$CTL" firewall off >/dev/null 2>&1
        return 0
    }

    if [ -n "${NFTFLOW_CONFIG_OVERRIDE:-}" ]; then
        [ "$NFTFLOW_CONFIG_OVERRIDE" = "$RUNTIME_CONFIG" ] || {
            logger -t nftflow "refusing unsupported runtime config override: $NFTFLOW_CONFIG_OVERRIDE"
            return 1
        }
        [ -f "$RUNTIME_CONFIG" ] || {
            logger -t nftflow "runtime config override is missing: $RUNTIME_CONFIG"
            return 1
        }
        config_file="$RUNTIME_CONFIG"
    fi

    command -v "$xray_bin" >/dev/null 2>&1 || {
        logger -t nftflow "Xray binary not found: $xray_bin"
        return 1
    }
    ensure_group || return 1
    procd_open_instance
    # A LuCI Apply may pass the runtime snapshot as config_file for this
    # lifecycle only. Normal start/restart has no override and returns to the
    # persistent UCI-configured file.
    procd_set_param command "$CTL" run-guarded "$xray_bin" "$config_file" "$asset_dir"
    procd_set_param user root
    procd_set_param group "$run_group"
    procd_set_param env XRAY_LOCATION_ASSET="$asset_dir"
    procd_set_param limits nofile="${nofile} ${nofile}"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 60 5 5
    procd_close_instance
}

stop_service() {
    load_main
    if service_process_running; then
        local pid
        pid="$(cat /var/run/nftflow/xray.pid 2>/dev/null)"
        "$CTL" state stopping "$pid" 'service stop requested' >/dev/null 2>&1 || true
    fi
    "$CTL" firewall off >/dev/null 2>&1
    "$CTL" route del >/dev/null 2>&1
}

sync_boot_state() {
    load_main
    if [ "$enabled" = "1" ]; then
        enable
    else
        disable
    fi
}

reload_service() {
    sync_boot_state || return 1
    if [ "$enabled" = "1" ]; then
        if service_process_running; then
            "$CTL" reload
        else
            start
        fi
    else
        stop
    fi
}

service_triggers() {
    procd_add_reload_trigger nftflow
}

install() {
    "$CTL" prepare
    logger -t nftflow "firewall source is /etc/nftflow/firewall.nft; routing source is /etc/nftflow/routing.conf"
}

uninstall() {
    stop >/dev/null 2>&1 || true
    disable 2>/dev/null || true

    remove_geodata_schedule ||
        logger -t nftflow "cannot remove weekly GeoData update schedule"

    "$CTL" cleanup >/dev/null 2>&1 || true
    remove_created_groups
}
